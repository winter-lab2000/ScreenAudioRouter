<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ScreenAudioRouter.ico</ApplicationIcon>
    <AssemblyTitle>ScreenAudioRouter</AssemblyTitle>
    <Product>ScreenAudioRouter</Product>
    <Version>0.1.0</Version>
    <Authors>ScreenAudioRouter</Authors>
    <Description>Per-monitor speaker and microphone routing for Windows</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ScreenAudioRouter.ico" Condition="Exists('Assets\ScreenAudioRouter.ico')" />
    <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
